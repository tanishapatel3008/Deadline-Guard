@{
    ViewData["Title"] = "Access Restricted";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 text-center">
            <div class="card p-5 shadow-sm border">
                <div class="text-warning mb-3 fs-1">
                    <i class="bi bi-shield-slash"></i>
                </div>
                <h3 class="fw-bold mb-2">Access Denied</h3>
                <p class="text-muted small mb-4">
                    You do not have permission to access the requested resource. DeadlineGuard strictly isolates user data.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="@Url.Action("Index", "Dashboard")" class="btn btn-indigo btn-sm">
                        <i class="bi bi-house me-1"></i> Return to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
