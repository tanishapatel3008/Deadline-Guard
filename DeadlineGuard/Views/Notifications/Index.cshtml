@model List<DeadlineGuard.Models.Notification>
@{
    ViewData["Title"] = "Notification Center";
    bool unreadOnly = (bool)(ViewData["UnreadOnly"] ?? false);
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1">Notification Center</h3>
            <p class="text-muted small mb-0">System alerts, automated scheduled reminders, and urgency warnings</p>
        </div>
        <div class="d-flex gap-2">
            <div class="btn-group btn-group-sm">
                <a href="@Url.Action("Index", "Notifications", new { unreadOnly = false })" class="btn @(!unreadOnly ? "btn-dark" : "btn-outline-secondary")">
                    All
                </a>
                <a href="@Url.Action("Index", "Notifications", new { unreadOnly = true })" class="btn @(unreadOnly ? "btn-dark" : "btn-outline-secondary")">
                    Unread Only
                </a>
            </div>

            <form asp-action="MarkAllRead" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-check2-all me-1"></i> Mark All as Read
                </button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-bell-slash fs-1 d-block mb-2 text-secondary"></i>
                    <h5 class="fw-bold">No notifications</h5>
                    <p class="small mb-0">You're all caught up with your deadline reminders and alerts.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var n in Model)
                    {
                        var isUnread = n.ReadAt == null;

                        <div class="list-group-item p-3 @(isUnread ? "bg-light border-start border-3 border-primary" : "")">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-inline-flex p-2 rounded-circle @(isUnread ? "bg-primary-subtle text-primary" : "bg-light text-muted")">
                                        <i class="bi @(n.NotificationType == "UrgencyWarning" ? "bi-exclamation-triangle" : (n.NotificationType == "System" ? "bi-info-circle" : "bi-bell"))"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark @(isUnread ? "fw-bold" : "")">
                                            @n.Title
                                        </h6>
                                        <div class="text-muted" style="font-size: 0.75rem;">
                                            @n.CreatedAt.ToString("MMM dd, yyyy HH:mm") UTC
                                            @if (n.Deadline != null)
                                            {
                                                <span>&bull; Deadline: <a href="@Url.Action("Details", "Deadlines", new { id = n.DeadlineId })" class="text-decoration-none">@n.Deadline.Title</a></span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    @if (isUnread)
                                    {
                                        <form asp-action="MarkRead" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@n.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;">
                                                Mark Read
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@n.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.75rem;" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <p class="text-secondary small mb-0 ps-5">
                                @n.Message
                            </p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
