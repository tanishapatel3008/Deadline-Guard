@model DeadlineGuard.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password — DeadlineGuard";
}

<div class="dg-auth-container justify-content-center align-items-center">
    <div class="dg-auth-card-pane">
        <div class="dg-auth-glass-card">
            <!-- Brand Logo Header -->
            <div class="text-center mb-4">
                <a href="@Url.Action("Login", "Account")" class="d-inline-flex align-items-center gap-2 text-decoration-none">
                    <img src="~/images/logo-brand.svg" alt="DeadlineGuard" style="height: 42px; width: auto;" />
                    <span class="fs-4 fw-bold text-dark">Deadline<span class="text-purple">Guard</span></span>
                </a>
            </div>

            <div class="dg-card-header text-center">
                <div class="dg-card-eyebrow-line d-inline-block">
                    <span class="dg-card-eyebrow">RESET</span>
                </div>
                <h2 class="dg-card-title">Set New Password</h2>
                <p class="dg-card-subtitle">Choose a secure password for your account.</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="dg-auth-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-3"></div>

                <div class="dg-form-group mb-3">
                    <div class="dg-input-wrapper">
                        <i class="bi bi-lock dg-input-icon"></i>
                        <input asp-for="Password" type="password" id="resetPasswordInput" class="dg-form-input dg-input-with-toggle" placeholder="New password" />
                        <button type="button" class="dg-password-toggle" data-target="resetPasswordInput" title="Toggle password visibility" tabindex="-1">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="dg-validation-msg"></span>
                </div>

                <div class="dg-form-group mb-4">
                    <div class="dg-input-wrapper">
                        <i class="bi bi-check2-circle dg-input-icon"></i>
                        <input asp-for="ConfirmPassword" type="password" id="resetConfirmInput" class="dg-form-input dg-input-with-toggle" placeholder="Confirm new password" />
                        <button type="button" class="dg-password-toggle" data-target="resetConfirmInput" title="Toggle password visibility" tabindex="-1">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="dg-validation-msg"></span>
                </div>

                <button type="submit" class="dg-btn-primary w-100 btn-auth-submit">
                    <span class="spinner-border spinner-border-sm btn-spinner d-none me-2" role="status" aria-hidden="true"></span>
                    <span class="btn-text">Update Password <i class="bi bi-arrow-right ms-1"></i></span>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
