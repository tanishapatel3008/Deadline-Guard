@model DeadlineGuard.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Password Recovery — DeadlineGuard";
}

<div class="dg-auth-container justify-content-center align-items-center">
    <div class="dg-auth-card-pane">
        <div class="dg-auth-glass-card">
            <!-- Brand Logo Header -->
            <div class="text-center mb-4">
                <a href="@Url.Action("Login", "Account")" class="d-inline-flex align-items-center gap-2 text-decoration-none">
                    <img src="~/images/logo-brand.svg" alt="DeadlineGuard" style="height: 42px; width: auto;" />
                    <span class="fs-4 fw-bold text-dark">Deadline<span class="text-purple">Guard</span></span>
                </a>
            </div>

            <div class="dg-card-header text-center">
                <div class="dg-card-eyebrow-line d-inline-block">
                    <span class="dg-card-eyebrow">RECOVERY</span>
                </div>
                <h2 class="dg-card-title">Password Recovery</h2>
                <p class="dg-card-subtitle">Enter your registered email to receive reset instructions.</p>
            </div>

            <form asp-action="ForgotPassword" method="post" class="dg-auth-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-3"></div>

                <div class="dg-form-group mb-4">
                    <div class="dg-input-wrapper">
                        <i class="bi bi-envelope dg-input-icon"></i>
                        <input asp-for="Email" class="dg-form-input" placeholder="Email address" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="dg-validation-msg"></span>
                </div>

                <button type="submit" class="dg-btn-primary w-100 btn-auth-submit">
                    <span class="spinner-border spinner-border-sm btn-spinner d-none me-2" role="status" aria-hidden="true"></span>
                    <span class="btn-text">Send Reset Link <i class="bi bi-arrow-right ms-1"></i></span>
                </button>
            </form>

            <div class="dg-card-footer text-center">
                <span class="text-muted">Remembered your password?</span>
                <a href="@Url.Action("Login", "Account")" class="dg-footer-link">Return to login</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
