@model DeadlineGuard.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Settings & Preferences";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Settings & Preferences</h3>
            <p class="text-muted small mb-0">Manage notification channels, conflict thresholds, and account security</p>
        </div>
    </div>

    <form asp-action="Profile" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="row g-4">
            <!-- Profile Information -->
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header-clean d-flex align-items-center gap-2">
                        <i class="bi bi-person-gear text-primary"></i>
                        <span>User Profile</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label small fw-semibold text-muted"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                            <input asp-for="Email" class="form-control bg-light" readonly />
                            <small class="text-muted">Primary account email used for sign-in and notifications.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TimeZoneId" class="form-label small fw-semibold text-muted"></label>
                            <select asp-for="TimeZoneId" class="form-select">
                                <option value="UTC">UTC (Coordinated Universal Time)</option>
                                <option value="Eastern Standard Time">Eastern Time (US & Canada)</option>
                                <option value="Central Standard Time">Central Time (US & Canada)</option>
                                <option value="Pacific Standard Time">Pacific Time (US & Canada)</option>
                                <option value="GMT Standard Time">GMT / London</option>
                                <option value="India Standard Time">India Standard Time (IST)</option>
                                <option value="Singapore Standard Time">Singapore / Hong Kong (SGT)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PreferredTheme" class="form-label small fw-semibold text-muted"></label>
                            <select asp-for="PreferredTheme" class="form-select">
                                <option value="light">Light Mode (Clean SaaS)</option>
                                <option value="dark">Dark Mode</option>
                                <option value="system">Follow System</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reminder & Conflict Preferences -->
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header-clean d-flex align-items-center gap-2">
                        <i class="bi bi-sliders text-warning"></i>
                        <span>Notification & Conflict Settings</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="AvailableDailyPrepMinutes" class="form-label small fw-semibold text-muted"></label>
                            <div class="input-group">
                                <input asp-for="AvailableDailyPrepMinutes" class="form-control" type="number" step="30" />
                                <span class="input-group-text bg-light text-muted">minutes/day</span>
                            </div>
                            <small class="text-muted">Used by Conflict Engine: alerts if total daily task preparation exceeds this threshold.</small>
                            <span asp-validation-for="AvailableDailyPrepMinutes" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DefaultReminderMinutes" class="form-label small fw-semibold text-muted"></label>
                            <div class="input-group">
                                <input asp-for="DefaultReminderMinutes" class="form-control" type="number" step="60" />
                                <span class="input-group-text bg-light text-muted">minutes before due</span>
                            </div>
                            <span asp-validation-for="DefaultReminderMinutes" class="text-danger small"></span>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="InAppNotificationsEnabled" class="form-check-input" type="checkbox" />
                            <label asp-for="InAppNotificationsEnabled" class="form-check-label small fw-medium">Enable In-App Notifications</label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="EmailNotificationsEnabled" class="form-check-input" type="checkbox" />
                            <label asp-for="EmailNotificationsEnabled" class="form-check-label small fw-medium">Enable Email Reminders via SMTP</label>
                            <div class="form-text small">Dispatches an email when scheduled reminders fire (requires configured SMTP).</div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="DailySummaryEnabled" class="form-check-input" type="checkbox" />
                            <label asp-for="DailySummaryEnabled" class="form-check-label small fw-medium">Enable Daily Action Plan Summary</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Password Change Card -->
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header-clean d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock text-danger"></i>
                        <span>Security & Password (Optional)</span>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="CurrentPassword" class="form-label small fw-semibold text-muted"></label>
                                <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="••••••••" />
                                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="NewPassword" class="form-label small fw-semibold text-muted"></label>
                                <input asp-for="NewPassword" type="password" class="form-control" placeholder="New password" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ConfirmNewPassword" class="form-label small fw-semibold text-muted"></label>
                                <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Confirm new password" />
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex justify-content-end">
            <button type="submit" class="btn btn-indigo px-4 py-2 shadow-sm">
                <i class="bi bi-check2-circle me-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
