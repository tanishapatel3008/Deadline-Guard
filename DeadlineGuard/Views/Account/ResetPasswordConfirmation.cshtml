@{
    ViewData["Title"] = "Password Reset Complete — DeadlineGuard";
}

<div class="dg-auth-container justify-content-center align-items-center">
    <div class="dg-auth-card-pane">
        <div class="dg-auth-glass-card text-center">
            <!-- Brand Logo Header -->
            <div class="mb-4">
                <a href="@Url.Action("Login", "Account")" class="d-inline-flex align-items-center gap-2 text-decoration-none">
                    <img src="~/images/logo-brand.svg" alt="DeadlineGuard" style="height: 42px; width: auto;" />
                    <span class="fs-4 fw-bold text-dark">Deadline<span class="text-purple">Guard</span></span>
                </a>
            </div>

            <div class="text-success mb-3 fs-1">
                <i class="bi bi-shield-check"></i>
            </div>
            <h2 class="dg-card-title mb-2">Password Reset Complete</h2>
            <p class="dg-card-subtitle mb-4">
                Your password has been reset successfully. You can now sign in with your new credentials.
            </p>

            <a href="@Url.Action("Login", "Account")" class="dg-btn-primary w-100 text-decoration-none">
                Sign In Now <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>
