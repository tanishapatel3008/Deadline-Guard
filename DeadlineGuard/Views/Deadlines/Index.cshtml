@model DeadlineGuard.ViewModels.DeadlineListViewModel
@{
    bool isOverdueView = ViewData["IsOverdueView"] != null;
    bool isCompletedView = ViewData["IsCompletedView"] != null;
    ViewData["Title"] = isOverdueView ? "Overdue Deadlines" : (isCompletedView ? "Completed Deadlines Archive" : "All Deadlines");
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1">
                @if (isOverdueView)
                {
                    <span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Overdue Deadlines</span>
                }
                else if (isCompletedView)
                {
                    <span class="text-success"><i class="bi bi-check2-all me-2"></i>Completed Archive</span>
                }
                else
                {
                    <span>All Managed Deadlines</span>
                }
            </h3>
            <p class="text-muted small mb-0">
                @Model.TotalItems total record(s) matching your criteria &bull; Page @Model.CurrentPage of @Math.Max(1, Model.TotalPages)
            </p>
        </div>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Create", "Deadlines")" class="btn btn-indigo btn-sm shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Deadline
            </a>
        </div>
    </div>

    <!-- Filters & Search Toolbar Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search title or notes..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <select name="categoryFilter" class="form-select form-select-sm">
                        <option value="">All Categories</option>
                        @foreach (var cat in Enum.GetValues<DeadlineCategory>())
                        {
                            <option value="@cat" selected="@(Model.CategoryFilter == cat)">@cat</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="priorityFilter" class="form-select form-select-sm">
                        <option value="">All Priorities</option>
                        @foreach (var pri in Enum.GetValues<PriorityClassification>())
                        {
                            <option value="@pri" selected="@(Model.PriorityFilter == pri)">@pri Priority</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="dateFilter" class="form-select form-select-sm">
                        <option value="all" selected="@(Model.DateFilter == "all")">Any Time</option>
                        <option value="today" selected="@(Model.DateFilter == "today")">Due Today</option>
                        <option value="next7" selected="@(Model.DateFilter == "next7")">Next 7 Days</option>
                        <option value="overdue" selected="@(Model.DateFilter == "overdue")">Overdue Only</option>
                        <option value="month" selected="@(Model.DateFilter == "month")">This Month</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select name="sortBy" class="form-select form-select-sm">
                        <option value="priority" selected="@(Model.SortBy == "priority")">Sort: Priority Score</option>
                        <option value="duedate" selected="@(Model.SortBy == "duedate")">Sort: Due Date</option>
                        <option value="consequence" selected="@(Model.SortBy == "consequence")">Sort: Consequence</option>
                        <option value="effort" selected="@(Model.SortBy == "effort")">Sort: Estimated Effort</option>
                    </select>
                </div>

                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-dark btn-sm w-100" title="Apply Filters">Filter</button>
                    <a href="@Url.Action("Index", "Deadlines")" class="btn btn-outline-secondary btn-sm" title="Clear Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table of Deadlines -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Deadlines.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                    <h5 class="fw-bold">No deadlines found</h5>
                    <p class="small mb-3">Try adjusting your filters or search term, or create a new deadline.</p>
                    <a href="@Url.Action("Create", "Deadlines")" class="btn btn-indigo btn-sm">Create New Deadline</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th style="width: 130px;">Priority</th>
                                <th>Deadline & Category</th>
                                <th>Due Date (UTC)</th>
                                <th>Time Remaining</th>
                                <th>Consequence</th>
                                <th>Effort</th>
                                <th>Status</th>
                                <th class="text-end" style="width: 160px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Deadlines)
                            {
                                var d = item.Deadline;
                                var p = item.Priority;

                                <tr>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <span class="@p.BadgeCssClass" style="font-size: 0.75rem;">
                                                @p.Classification (@p.Score)
                                            </span>
                                            <div class="priority-meter-bar">
                                                <div class="priority-meter-fill @p.ProgressColorClass" style="width: @p.Score%;"></div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div>
                                            <a href="@Url.Action("Details", "Deadlines", new { id = d.Id })" class="fw-bold text-dark text-decoration-none">
                                                @d.Title
                                            </a>
                                            <div class="d-flex align-items-center gap-1 mt-1 small">
                                                <span class="badge bg-light text-dark border">@d.Category</span>
                                                @if (d.IsRecurring)
                                                {
                                                    <span class="badge bg-light text-muted border" title="Recurs @d.RecurrenceRule"><i class="bi bi-repeat"></i> @d.RecurrenceRule</span>
                                                }
                                                @if (d.Attachments.Any())
                                                {
                                                    <span class="badge bg-light text-muted border"><i class="bi bi-paperclip"></i> @d.Attachments.Count</span>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="small fw-semibold">@d.DueDateTime.ToString("MMM dd, yyyy")</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@d.DueDateTime.ToString("HH:mm") UTC</div>
                                    </td>

                                    <td>
                                        <span class="small fw-semibold @(p.IsOverdue ? "text-danger" : "text-dark")">
                                            @p.TimeRemainingText
                                        </span>
                                    </td>

                                    <td>
                                        <div class="small fw-semibold">@d.ConsequenceLevel</div>
                                        @if (d.PotentialPenaltyAmount.HasValue && d.PotentialPenaltyAmount > 0)
                                        {
                                            <div class="text-danger small" style="font-size: 0.75rem;">
                                                @d.CurrencyCode @d.PotentialPenaltyAmount.Value.ToString("F2")
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted small" style="font-size: 0.75rem;">@d.ConsequenceType</div>
                                        }
                                    </td>

                                    <td>
                                        <span class="small text-muted">@p.EffortSummary</span>
                                    </td>

                                    <td>
                                        @switch (d.Status)
                                        {
                                            case DeadlineStatus.Pending:
                                                <span class="badge bg-secondary">Pending</span>
                                                break;
                                            case DeadlineStatus.InProgress:
                                                <span class="badge bg-primary">In Progress</span>
                                                break;
                                            case DeadlineStatus.Completed:
                                                <span class="badge bg-success">Completed</span>
                                                break;
                                            case DeadlineStatus.Cancelled:
                                                <span class="badge bg-dark">Cancelled</span>
                                                break;
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", "Deadlines", new { id = d.Id })" class="btn btn-outline-secondary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", "Deadlines", new { id = d.Id })" class="btn btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (d.Status != DeadlineStatus.Completed)
                                            {
                                                <button type="button" class="btn btn-outline-success" title="Mark Completed" data-bs-toggle="modal" data-bs-target="#completeModal-@d.Id">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                <!-- Complete Modal for this row -->
                                <div class="modal fade" id="completeModal-@d.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold">Complete Deadline</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-controller="Deadlines" asp-action="Complete" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@d.Id" />
                                                <div class="modal-body">
                                                    <p>Mark <strong>@d.Title</strong> as completed?</p>
                                                    @if (d.IsRecurring)
                                                    {
                                                        <div class="alert alert-info py-2 small">
                                                            <i class="bi bi-repeat me-1"></i> Recurring schedule detected: The next cycle will automatically be scheduled.
                                                        </div>
                                                    }
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold text-muted">Completion Notes</label>
                                                        <textarea name="completionNotes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success">Mark Completed</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                @if (Model.TotalPages > 1)
                {
                    <div class="p-3 d-flex justify-content-between align-items-center border-top">
                        <small class="text-muted">
                            Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1) to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) of @Model.TotalItems entries
                        </small>
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { currentPage = Model.CurrentPage - 1, searchTerm = Model.SearchTerm, categoryFilter = Model.CategoryFilter, priorityFilter = Model.PriorityFilter, dateFilter = Model.DateFilter, sortBy = Model.SortBy })">Previous</a>
                                </li>
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { currentPage = p, searchTerm = Model.SearchTerm, categoryFilter = Model.CategoryFilter, priorityFilter = Model.PriorityFilter, dateFilter = Model.DateFilter, sortBy = Model.SortBy })">@p</a>
                                    </li>
                                }
                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { currentPage = Model.CurrentPage + 1, searchTerm = Model.SearchTerm, categoryFilter = Model.CategoryFilter, priorityFilter = Model.PriorityFilter, dateFilter = Model.DateFilter, sortBy = Model.SortBy })">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>
