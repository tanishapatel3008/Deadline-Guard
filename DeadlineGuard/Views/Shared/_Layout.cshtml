@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject DeadlineGuard.Data.ApplicationDbContext DbContext

@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var currentUserId = currentUser?.Id;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAuthPage = (currentController == "Account" && currentAction != "Profile");

    int overdueBadge = 0;
    int notifBadge = 0;
    if (currentUserId != null)
    {
        var now = DateTime.UtcNow;
        overdueBadge = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.CountAsync(
            DbContext.Deadlines.Where(d => d.UserId == currentUserId && d.Status != DeadlineGuard.Models.Enums.DeadlineStatus.Completed && d.Status != DeadlineGuard.Models.Enums.DeadlineStatus.Cancelled && d.DueDateTime < now));
        notifBadge = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.CountAsync(
            DbContext.Notifications.Where(n => n.UserId == currentUserId && n.ReadAt == null));
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DeadlineGuard</title>
    
    <!-- Google Fonts: Plus Jakarta Sans, Inter, Playfair Display, Caveat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/images/logo-brand.svg" />
    <link rel="alternate icon" type="image/png" href="~/images/favicon-64.png" />
    
    <!-- Master Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="dg-app-shell" id="wrapper">
            <!-- Left Persistent Sidebar -->
            <aside class="dg-sidebar" id="sidebar-wrapper">
                <!-- Sidebar Brand -->
                <div class="dg-sidebar-brand">
                    <a href="@Url.Action("Index", "Dashboard")" class="dg-sidebar-logo-link">
                        <img src="~/images/logo-brand.svg" alt="DeadlineGuard" class="dg-sidebar-logo-img" />
                        <div class="dg-sidebar-logo-text">
                            <span class="dg-sidebar-logo-name">Deadline<span>Guard</span></span>
                            <span class="dg-sidebar-logo-sub">Automatic Deadline &amp; Penalty Tracker</span>
                        </div>
                    </a>
                </div>

                <!-- Navigation Links -->
                <nav class="dg-sidebar-nav">
                    <!-- Dashboard -->
                    <a href="@Url.Action("Index", "Dashboard")" class="dg-sidebar-link @(currentController == "Dashboard" && currentAction == "Index" ? "active" : "")">
                        <span class="dg-sidebar-link-icon">
                            <i class="bi bi-grid-fill"></i>
                        </span>
                        <span>Dashboard</span>
                    </a>

                    <!-- Section: ALL DEADLINES -->
                    <div class="dg-sidebar-section-title">ALL DEADLINES</div>

                    <a href="@Url.Action("Index", "Deadlines")" class="dg-sidebar-link @(currentController == "Deadlines" && (currentAction == "Index" || currentAction == "Create" || currentAction == "Edit" || currentAction == "Details") && ViewData["IsOverdueView"] == null && ViewData["IsCompletedView"] == null ? "active" : "")">
                        <span class="dg-sidebar-link-icon"><i class="bi bi-list-task"></i></span>
                        <span>All Deadlines</span>
                    </a>

                    <a href="@Url.Action("Overdue", "Deadlines")" class="dg-sidebar-link @(ViewData["IsOverdueView"] != null || (currentController == "Deadlines" && currentAction == "Overdue") ? "active" : "")">
                        <span class="dg-sidebar-link-icon"><i class="bi bi-exclamation-triangle"></i></span>
                        <span class="flex-grow-1">Overdue Tasks</span>
                        @if (overdueBadge > 0)
                        {
                            <span class="dg-sidebar-badge dg-badge-danger">@overdueBadge</span>
                        }
                    </a>

                    <!-- Section: INTELLIGENCE -->
                    <div class="dg-sidebar-section-title">INTELLIGENCE</div>

                    <a href="@Url.Action("Index", "Conflicts")" class="dg-sidebar-link @(currentController == "Conflicts" ? "active" : "")">
                        <span class="dg-sidebar-link-icon"><i class="bi bi-intersect"></i></span>
                        <span>Conflict Center</span>
                    </a>

                    <a href="@Url.Action("Calendar", "Dashboard")" class="dg-sidebar-link @(currentController == "Dashboard" && currentAction == "Calendar" ? "active" : "")">
                        <span class="dg-sidebar-link-icon"><i class="bi bi-calendar3"></i></span>
                        <span>Timeline &amp; Calendar</span>
                    </a>

                    <!-- Section: HISTORY & RECORDS -->
                    <div class="dg-sidebar-section-title">HISTORY &amp; RECORDS</div>

                    <a href="@Url.Action("Completed", "Deadlines")" class="dg-sidebar-link @(ViewData["IsCompletedView"] != null || (currentController == "Deadlines" && currentAction == "Completed") ? "active" : "")">
                        <span class="dg-sidebar-link-icon"><i class="bi bi-check2-circle"></i></span>
                        <span>Completed Archive</span>
                    </a>

                    <a href="@Url.Action("Index", "Notifications")" class="dg-sidebar-link @(currentController == "Notifications" ? "active" : "")">
                        <span class="dg-sidebar-link-icon"><i class="bi bi-bell"></i></span>
                        <span class="flex-grow-1">Notification Center</span>
                        @if (notifBadge > 0)
                        {
                            <span class="dg-sidebar-badge dg-badge-danger">@notifBadge</span>
                        }
                    </a>

                    <!-- Section: ACCOUNT -->
                    <div class="dg-sidebar-section-title">ACCOUNT</div>

                    <a href="@Url.Action("Profile", "Account")" class="dg-sidebar-link @(currentController == "Account" && currentAction == "Profile" ? "active" : "")">
                        <span class="dg-sidebar-link-icon"><i class="bi bi-gear"></i></span>
                        <span>Settings &amp; Preferences</span>
                    </a>
                </nav>

                <!-- Sidebar User Footer -->
                <div class="dg-sidebar-footer">
                    <div class="dg-sidebar-user">
                        <div class="dg-sidebar-avatar">
                            @(currentUser?.FullName?.Length > 0 ? currentUser.FullName[0].ToString().ToUpper() : "U")
                        </div>
                        <div class="dg-sidebar-user-info">
                            <div class="dg-sidebar-user-name">@(currentUser?.FullName ?? "User")</div>
                            <div class="dg-sidebar-user-email">@currentUser?.Email</div>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-auto">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dg-sidebar-logout-btn" title="Sign out">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <!-- Page Content Wrapper -->
            <div id="page-content-wrapper" class="dg-content-wrapper">
                <!-- Top Navbar -->
                <nav class="dg-top-nav">
                    <div class="dg-top-nav-left">
                        <button class="dg-sidebar-toggle d-lg-none" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <form class="dg-search-form" asp-controller="Deadlines" asp-action="Index" method="get">
                            <i class="bi bi-search dg-search-icon"></i>
                            <input type="text" name="searchTerm" class="dg-search-input" placeholder="Search deadlines or tags..." autocomplete="off" />
                        </form>
                    </div>

                    <div class="dg-top-nav-right">
                        <!-- Notifications Bell -->
                        <a href="@Url.Action("Index", "Notifications")" class="dg-nav-icon-btn" title="Notifications">
                            <i class="bi bi-bell"></i>
                            @if (notifBadge > 0)
                            {
                                <span class="dg-nav-badge">@notifBadge</span>
                            }
                        </a>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <button class="dg-nav-user-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="dg-nav-avatar">
                                    @(currentUser?.FullName?.Length > 0 ? currentUser.FullName[0].ToString().ToUpper() : "U")
                                </div>
                                <span class="d-none d-sm-inline fw-semibold">@(currentUser?.FullName?.Split(' ')[0] ?? "User")</span>
                                <i class="bi bi-chevron-down ms-1" style="font-size: 0.75rem; color: #79768e;"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2">
                                <li><a class="dropdown-item py-2" href="@Url.Action("Profile", "Account")"><i class="bi bi-person me-2 text-primary"></i>Profile &amp; Settings</a></li>
                                <li><a class="dropdown-item py-2" href="@Url.Action("Index", "Conflicts")"><i class="bi bi-intersect me-2 text-warning"></i>Conflict Center</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 text-danger rounded"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>

                <!-- Main Page Body -->
                <main class="dg-main-content">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 border-0 rounded-3" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 border-0 rounded-3" role="alert">
                            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["InfoMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show shadow-sm mb-4 border-0 rounded-3" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>

                <footer class="dg-app-footer">
                    <span><strong>DeadlineGuard</strong> &bull; Automatic Deadline &amp; Penalty Tracker</span>
                    <span>&copy; @DateTime.UtcNow.Year DeadlineGuard. All rights reserved.</span>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Unauthenticated Authentication Container (Login / Register / Password Reset) -->
        <main>
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="container position-fixed top-0 start-50 translate-middle-x mt-3" style="max-width: 500px; z-index: 1050;">
                    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="container position-fixed top-0 start-50 translate-middle-x mt-3" style="max-width: 500px; z-index: 1050;">
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="container position-fixed top-0 start-50 translate-middle-x mt-3" style="max-width: 500px; z-index: 1050;">
                    <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }
            @RenderBody()
        </main>
    }

    <!-- Bootstrap 5 Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
